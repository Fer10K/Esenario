@page "/pedidos/nuevo"
@page "/pedidos/editar/{Id:int}"
@using Esenario.Modelo
@rendermode InteractiveServer
@inject NavigationManager _navigator
@inject IRepositorioPedidos _repositorio
@inject IRepositorioClientes _repositorioClientes
<h3>Nuevo Pedido</h3>

<EditForm Model="_pedido" OnValidSubmit="Guardar">
    <DataAnnotationsValidator/> 
    <div class="mb-3">
        <label>Cliente</label>
        <InputSelect class="form-select" @bind-Value="_pedido.ClienteId" disabled="@_edicion">
            <option value="0" enabled="enabled" >Seleccione un cliente</option>
            @foreach (var cliente in _clientes)
            {
                <option value="@cliente.Id_Cliente">@cliente.Nombre</option>
            }
        </InputSelect>
        <ValidationMessage For="() => _pedido.ClienteId" />
        
    </div>
    <div class="mb-3">
        <label>Fecha del Pedido</label>
        <InputDate class="form-control" @bind-Value="_pedido.Fecha_Pedido" />
        <ValidationMessage For="() => _pedido.Fecha_Pedido" />
    </div>
    <div class="mb-3">
        <label>Estado</label>
        <InputSelect class="form-select" @bind-Value="_pedido.Estado" placeholder="Seleccione un cliente">
            <option value="Pendiente">Pendiente</option>
            <option value="Entregado">Entregado</option>
        </InputSelect>
        <ValidationMessage For="() => _pedido.Estado" />
    </div>
    <button type="submit" class="btn btn-primary">Guardar</button>
    <button class="btn btn-danger ms-3" @onclick="Cancelar" @onclick:preventDefault>Cancelar</button>
</EditForm>

@code {
    private List<Cliente> _clientes = new();
    [Parameter]
    public int Id { get; set; }
    private Pedidos _pedido = new();
    private bool _edicion => Id > 0;

    protected override async Task OnInitializedAsync()
    {
        if (Id > 0)
        {
            var pedido = await _repositorio.Get(Id);
            if (pedido != null)
                _pedido = pedido;
        }
        var clientes = await _repositorioClientes.GetAll();
        _clientes = clientes;
    }

    private async Task Guardar()
    {
        if (_edicion)
        {
            await _repositorio.UpDate(Id, _pedido);
        }
        else
        {
            await _repositorio.Add(_pedido);
        }
        _navigator.NavigateTo("/pedidos");
    }
    private void Cancelar()
    {
        _navigator.NavigateTo("/pedidos");
    }
}
